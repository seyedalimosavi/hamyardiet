# SQLite database file. Use an ABSOLUTE path on shared hosting, ideally OUTSIDE
# any web-served directory (e.g. /home/USER/dietdata/diet.sqlite on cPanel).
# If unset, the app defaults to ./dietdata/diet.sqlite next to the app.
SQLITE_DB_PATH=./dietdata/diet.sqlite

# LOCAL TEST ONLY. This bypass does not provide authentication.
ALLOW_UNSAFE_DEMO=true
